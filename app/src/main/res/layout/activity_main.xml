<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 宛先1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonSelect1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="選択" />

        <EditText
            android:id="@+id/editTextTo1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="宛先メール1"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <!-- 宛先2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonSelect2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="選択" />

        <EditText
            android:id="@+id/editTextTo2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="宛先メール2"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <!-- 宛先3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonSelect3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="選択" />

        <EditText
            android:id="@+id/editTextTo3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="宛先メール3"
            android:inputType="textEmailAddress" />
    </LinearLayout>


    <!-- 件名 -->
    <EditText
        android:id="@+id/editTextSubject"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="件名" />

    <!-- 本文 -->
    <EditText
        android:id="@+id/editTextBody"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="本文"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <!-- 自動送信開始 -->
    <Button
        android:id="@+id/buttonStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="スリープ監視開始" />

    <!-- 自動送信停止 -->
    <Button
        android:id="@+id/buttonStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="緊急送信停止" />

    <!-- 手動送信 -->
    <Button
        android:id="@+id/buttonTestSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="テスト送信" />

    <!-- (Removed standalone contact select buttons, now included per row) -->

</LinearLayout>