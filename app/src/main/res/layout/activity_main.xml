<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 宛先1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール1"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 宛先2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール2"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 宛先3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール3"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 件名 -->
        <EditText
            android:id="@+id/editTextSubject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="件名" />

        <!-- 本文 -->
        <EditText
            android:id="@+id/editTextBody"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="本文"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <!-- 自動送信開始 -->
        <Button
            android:id="@+id/buttonStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="スリープ監視開始" />

        <!-- 自動送信停止 -->
        <Button
            android:id="@+id/buttonStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="緊急送信停止" />

        <!-- 手動送信 -->
        <Button
            android:id="@+id/buttonTestSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="テスト送信" />

        <!-- Worker設定セクション -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="── Worker設定 ──"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />

        <!-- [追加] 送信間隔 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="送信間隔（秒）："
                android:textSize="12sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/editTextSendInterval"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:inputType="number"
                android:hint="60" />
        </LinearLayout>

        <!-- Worker間隔 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker間隔（分）："
                android:textSize="12sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/editTextWorkerInterval"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:inputType="number"
                android:hint="15" />
        </LinearLayout>

        <!-- 無操作閾値 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="無操作閾値："
                android:textSize="12sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/editTextThreshold"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:inputType="number"
                android:hint="24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="時間（テストモード時は分）"
                android:textSize="12sp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- テストモード -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="テストモード（閾値を分単位に）："
                android:textSize="12sp"
                android:layout_gravity="center_vertical" />

            <Switch
                android:id="@+id/switchTestMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonSaveWorkerSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textSize="12sp"
            android:text="設定を保存" />

    </LinearLayout>
</ScrollView>