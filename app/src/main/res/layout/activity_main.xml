<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 宛先1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール1"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 宛先2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール2"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 宛先3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSelect3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />

            <EditText
                android:id="@+id/editTextTo3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="宛先メール3"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- 送信者名 -->
        <EditText
            android:id="@+id/editTextSenderName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="あなたの名前（例: 田中太郎）"
            android:inputType="textPersonName" />

        <!-- 送信者電話番号 -->
        <EditText
            android:id="@+id/editTextSenderPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="電話番号（例: 090-1234-5678）"
            android:inputType="phone" />

        <!-- メール送信時間 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonSendInterval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="メール送信時間" />

            <TextView
                android:id="@+id/textViewSendInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="未設定"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 画面ONタイムアウト -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonScreenOnTimeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="画面ON判定時間" />

            <TextView
                android:id="@+id/textViewScreenOnTimeout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="3分"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 画面ON判定の説明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定時間未満の画面点灯は操作したと判断しません"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- 設定保存 -->
        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="設定を保存" />

        <!-- テスト送信 -->
        <Button
            android:id="@+id/buttonTestSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="テスト送信" />

        <!-- 監視開始・停止（横並び） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginEnd="4dp"
                android:text="監視開始" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginStart="4dp"
                android:text="監視停止" />

        </LinearLayout>

        <!-- 権限状態表示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="必須設定　未設定の場合は設定してください。"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textViewBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textViewAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textViewBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>